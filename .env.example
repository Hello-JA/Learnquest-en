NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://user:password@localhost:3306/database

# OAuth provider values. Obtain these from your OAuth/Manus application.
APP_ID=Ov23li42gPHqa020tYK2
VITE_APP_ID=Ov23li42gPHqa020tYK2
VITE_OAUTH_PORTAL_URL=https://github.com/login/oauth/authorize
COOKIE_SECRET=replace-with-a-random-32-plus-char-string



# Optional built-in service integrations
BUILT_IN_FORGE_API_URL=https://your-forge-api.example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# Email notifications (Resend — https://resend.com)
# 1. Create a free account, then create an API key at resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# 2. The inbox that receives "new lead" notifications.
NOTIFICATION_EMAIL=you@example.com
# 3. Sender address. "onboarding@resend.dev" needs no setup but ONLY delivers to
#    the email your Resend account is registered under. To notify any address,
#    verify a domain at resend.com/domains and use "Name <hello@yourdomain.com>".
EMAIL_FROM=LearnQuest <onboarding@resend.dev>